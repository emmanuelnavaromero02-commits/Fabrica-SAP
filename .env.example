# Copia este archivo a .env y ajusta. Nunca subas .env al repositorio.

# mock = sin llaves (simulado) · live = proveedores reales
FABRICA_LLM_MODE=mock

# Llaves (solo con FABRICA_LLM_MODE=live)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Codex usa su propio login (`codex login`) o OPENAI_API_KEY.
FABRICA_CODEX_BIN=codex

# inline = el API ejecuta el flujo (local) · temporal = worker de Temporal
FABRICA_RUNNER=inline

# local = repos git en ./data/repos · gitea = API de Gitea
FABRICA_GIT_BACKEND=local
FABRICA_GITEA_URL=http://localhost:3000
FABRICA_GITEA_TOKEN=
FABRICA_GITEA_ORG=fabrica
