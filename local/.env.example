# Plantilla de variables del despliegue local.
# Copiar a .env y rellenar los secretos. NO poner secretos reales aqui.
#
#   Copy-Item .env.example .env
#
# Para generar un secreto/contrasena en PowerShell:
#   $b = New-Object byte[] 32; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''

# --- Versiones de imagen (fijadas; verificadas en el registry) ---
TAG=17-slim
GITEA_TAG=1.26
POSTGRES_VERSION=17

# --- Secretos de OpenProject ---
# SECRET_KEY_BASE: cadena pseudoaleatoria larga (>=64 bytes hex). Tratar como contrasena.
SECRET_KEY_BASE=CHANGE_ME
OP_DB_PASSWORD=CHANGE_ME

# --- Secretos de Gitea ---
GITEA_DB_PASSWORD=CHANGE_ME

# --- Admin de Gitea (lo consume el paso de validacion del README) ---
GITEA_ADMIN_USER=gitadmin
GITEA_ADMIN_PASSWORD=CHANGE_ME
GITEA_ADMIN_EMAIL=admin@example.com
