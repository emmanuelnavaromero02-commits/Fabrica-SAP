<mxfile host="app.diagrams.net">
  <diagram name="Arquitectura Fabrica" id="arch-fabrica-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" arrows="1" connect="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Fábrica de software — arquitectura (host AWS + MCPs + VPN a SAP de clientes)" parent="1" vertex="1"
                style="text;html=1;fontSize=20;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#232F3E;">
          <mxGeometry x="40" y="24" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="laptop" value="Claude Code / Codex&#10;(laptop del dev)" parent="1" vertex="1"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontStyle=1;">
          <mxGeometry x="40" y="240" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="users" value="Consultores / PM&#10;(navegador)" parent="1" vertex="1"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontStyle=1;">
          <mxGeometry x="40" y="600" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- AWS Cloud frame -->
        <mxCell id="cloud" value="AWS Cloud · us-east-1 · EIP 98.87.73.201" parent="1" vertex="1"
                style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;">
          <mxGeometry x="240" y="90" width="1080" height="930" as="geometry" />
        </mxCell>

        <!-- SSM / Parameter Store -->
        <mxCell id="ssm" value="AWS SSM&#10;RunCommand (vpnctl) +&#10;Parameter Store&#10;/fabrica-sw/{vpn,abap,cpi}" parent="1" vertex="1"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EBF0;strokeColor=#232F3E;fontColor=#232F3E;fontStyle=1;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="1070" y="150" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- EC2 host frame -->
        <mxCell id="ec2" value="EC2 · fabrica-sw-host  (Docker Compose: fabrica-aws)" parent="1" vertex="1"
                style="rounded=1;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#232F3E;fillColor=#F7F9FB;strokeColor=#232F3E;dashed=0;">
          <mxGeometry x="270" y="150" width="760" height="850" as="geometry" />
        </mxCell>

        <!-- Caddy front door -->
        <mxCell id="caddy" value="Caddy — TLS + basic_auth (front door: mcp.&lt;dominio&gt;, panel, gitea, temporal-ui)" parent="1" vertex="1"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;">
          <mxGeometry x="300" y="210" width="700" height="52" as="geometry" />
        </mxCell>

        <!-- MCP layer -->
        <mxCell id="mcpbox" value="MCP (HTTP, detrás de Caddy)" parent="1" vertex="1"
                style="rounded=1;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#ED7100;fillColor=#FFF7F0;strokeColor=#ED7100;dashed=0;">
          <mxGeometry x="300" y="300" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="abapmcp" value="abap-mcp&#10;(ADT → SAP)" parent="1" vertex="1"
