          <mxGeometry x="800" y="648" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dbs" value="Datastores dedicados: gitea-db · keycloak-db · temporal-db  (Postgres, uno por servicio)" parent="1" vertex="1"
