          <mxGeometry x="320" y="760" width="640" height="44" as="geometry" />
        </mxCell>

        <!-- Client SAP frame -->
        <mxCell id="sapframe" value="Clientes SAP (on-prem, por VPN)" parent="1" vertex="1"
