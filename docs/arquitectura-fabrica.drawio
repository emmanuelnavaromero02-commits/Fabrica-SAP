          <mxGeometry x="490" y="340" width="150" height="56" as="geometry" />
        </mxCell>

        <!-- openfortivpn -->
        <mxCell id="vpn" value="openfortivpn (en el host)&#10;split-tunnel por cliente&#10;rutas → ppp0/ppp1" parent="1" vertex="1"
