# Plantilla del .env de la capa de aplicación AWS. Copiar a .env en la instancia
# y rellenar. EL .env REAL NO SE VERSIONA (lleva secretos). Permisos: chmod 600.
#
# Alternativa recomendada: guardar los secretos en SSM Parameter Store y
# generar este .env en la instancia con un script (ver README).
#
# Generar un secreto fuerte (en la instancia):  openssl rand -hex 32
# Cookie de oauth2-proxy (EXACTAMENTE 32 bytes):  openssl rand -base64 32 | head -c 32

# ===== Dominio / TLS (los usa la compose para interpolar) =====
BASE_DOMAIN=peru.epiuse.darkswf.7businesssolutions.com
ACME_EMAIL=tu-correo@7businesssolutions.com
AWS_REGION=us-east-1

# ===== Versiones de imagen (verificadas) =====
OP_TAG=17-slim
GITEA_TAG=1.26
POSTGRES_VERSION=17

# ===== Postgres (uno por sistema) =====
OP_DB_PASSWORD=CHANGE_ME
GITEA_DB_PASSWORD=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME
TEMPORAL_DB_PASSWORD=CHANGE_ME

# ===== OpenProject =====
SECRET_KEY_BASE=CHANGE_ME_64_HEX

# ===== Keycloak admin (bootstrap del IdP + lo usa el Panel para gestionar users) =====
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME

# ===== Secretos de clientes OIDC (deben COINCIDIR con los clients del realm) =====
INBOX_OIDC_CLIENT_SECRET=CHANGE_ME
PANEL_OIDC_CLIENT_SECRET=CHANGE_ME
TEMPORAL_OIDC_CLIENT_SECRET=CHANGE_ME
TEMPORAL_COOKIE_SECRET=CHANGE_ME_32_BYTES
# Secret del client 'openproject' del realm. Lo consume el seed del proveedor
# OIDC de OpenProject (local/seed-oidc-provider.rb). Debe COINCIDIR con el realm.
OP_OIDC_CLIENT_SECRET=CHANGE_ME

# ===== Sesión de las apps (inbox/panel) =====
SESSION_SECRET=CHANGE_ME_32_BYTES_MIN

# ===== Tokens de integración =====
# Token de API de OpenProject del usuario de servicio "Fabro" (rol restringido).
OPENPROJECT_API_TOKEN=CHANGE_ME
# Token de API de Gitea acotado a los repos de la fábrica.
GITEA_API_TOKEN=CHANGE_ME
# Token de Gitea con scope ADMIN (write:admin), para que el Panel CREE cuentas de
# usuario (POST /admin/users) al provisionar acceso. Si se deja vacío, el panel NO
# puede crear cuentas: el consultor debe entrar 1 vez por SSO y luego re-provisionar.
# Generarlo con: gitea admin user generate-access-token --username <admin> --scopes all
GITEA_ADMIN_TOKEN=CHANGE_ME
# Secreto del webhook de OpenProject (el brief EXIGE validar la firma en prod).
OPENPROJECT_WEBHOOK_SECRET=CHANGE_ME

# ===== Agente de IA =====
ANTHROPIC_API_KEY=CHANGE_ME
FACTORY_MODEL=claude-sonnet-4-6

# ===== Repo de la fábrica en Gitea (artefactos versionados) =====
FACTORY_GITEA_OWNER=mcp-agent
FACTORY_GITEA_REPO=fabrica
FACTORY_ARCH_REPO=mcp-agent/fabrica-arquitectura
FACTORY_ARCH_PATH=arquitectura.md
FACTORY_ARCH_BRANCH=main
FACTORY_SPEC_TEMPLATE_PATH=spec_template.md
FACTORY_SKILL_PATH=skill.md
FACTORY_PIPELINE_PATH=pipeline.yaml

# ===== S3 nativo para adjuntos (presigned). Llaves del usuario IAM que crea =====
# Terraform (output app_access_key_id / app_secret_access_key). El bucket se
# inyecta por la compose (ATTACHMENTS_BUCKET = output attachments_bucket de TF).
ATTACHMENTS_BUCKET=fabrica-sw-attachments-203677518499
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ===== MCP `fabrica` (hosted en mcp.<BASE_DOMAIN>) =====
# Token bearer que exige el servidor MCP. Lo pone el desarrollador en su
# Claude Code (Authorization: Bearer ...). Generar: openssl rand -hex 32
FABRICA_MCP_TOKEN=CHANGE_ME

# ===== Estados del workflow de OpenProject (alinear con los estados REALES) =====
OP_STATUS_ASSIGNED=Asignado a la fabrica
OP_STATUS_IN_REVIEW=En revision
OP_STATUS_IN_DEVELOPMENT=En desarrollo
OP_STATUS_CLIENT_OK=VoBo del cliente
OP_STATUS_AWAITING_CLARIFICATION=Esperando clarificacion
OP_STATUS_READY_FOR_QA=Lista para pruebas
