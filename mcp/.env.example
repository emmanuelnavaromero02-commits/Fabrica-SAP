# Variables del componente MCP. Copiar a mcp/.env y rellenar los tokens.
#
#   Copy-Item mcp\.env.example mcp\.env
#
# mcp/.env NO se versiona (ver mcp/.gitignore). Lo lee `docker run --env-file`
# y sirve para los dos servidores MCP: cada uno toma solo las variables que
# le corresponden e ignora el resto.
#
# Las URLs apuntan al despliegue LOCAL (Docker Desktop). host.docker.internal
# es el host visto desde dentro del contenedor del servidor MCP.
# Para AWS, cambiar las URLs a https://op.epiuse.lat y https://git.epiuse.lat
# (y regenerar los tokens contra esa instancia).

# --- OpenProject (servidor MCP custom) ---
OPENPROJECT_BASE_URL=http://host.docker.internal:8080
OPENPROJECT_API_TOKEN=CHANGE_ME
# Enviar notificaciones por correo al crear/editar work packages (def. false).
OPENPROJECT_NOTIFY=false
# Cabecera Host. OpenProject valida el Host contra su ajuste host_name. En
# local se alcanza por host.docker.internal pero la instancia espera
# localhost:8080. En AWS la URL ya coincide con host_name: dejar vacio.
OPENPROJECT_HOST_HEADER=localhost:8080

# --- Gitea (servidor MCP oficial gitea-mcp) ---
GITEA_HOST=http://host.docker.internal:3000
GITEA_ACCESS_TOKEN=CHANGE_ME

# --- Fabrica (servidor MCP `fabrica`: puente desarrollo local <-> fabrica) ---
# Imagen: docker build -t reqplatform-fabrica-mcp:0.1.0 mcp/fabrica
# Lo lanza el .mcp.json del REPO DEL REQUERIMIENTO (no este workspace), que
# inyecta ademas FABRICA_WP/FABRICA_ORG/FABRICA_REPO de ESE requerimiento.
GITEA_BASE_URL=http://host.docker.internal:3000
# GITEA_API_TOKEN: token Gitea (lee arquitectura, lee/escribe el repo del req).
GITEA_API_TOKEN=CHANGE_ME
FACTORY_ARCH_REPO=mcp-agent/fabrica-arquitectura
FACTORY_ARCH_BRANCH=main
FACTORY_ARCH_PATH=arquitectura.md
FACTORY_SKILLS_CATALOG_PATH=skills/catalog.yaml
# Webhook de la fabrica (para liberar_a_pruebas -> firma la compuerta).
# Local: http://host.docker.internal:8000 ; AWS: https://inbox.<BASE_DOMAIN>
FACTORY_WEBHOOK_URL=http://host.docker.internal:8000

# Transporte (AGNOSTICO AL AMBIENTE; mismo codigo, solo cambia esto):
#   stdio = dev local, lo lanza Claude Code por `docker run -i` (single-req: usa
#           el contexto por env de abajo).
#   http  = servicio HOSTED (detras de Caddy en AWS, o 127.0.0.1 para probar el
#           flujo remoto en local). Con FABRICA_MCP_TOKEN se EXIGE Bearer.
FABRICA_MCP_TRANSPORT=stdio
FABRICA_MCP_HOST=0.0.0.0
FABRICA_MCP_PORT=8080
FABRICA_MCP_PATH=/mcp
# Token bearer del endpoint hosted (vacio = sin auth; en AWS SIEMPRE ponerlo).
FABRICA_MCP_TOKEN=

# Contexto del requerimiento. En modo hosted (compartido) las tools reciben
# org/repo/wp por argumento (no hace falta esto). En stdio single-req local lo
# fija el .mcp.json sembrado en el repo del requerimiento:
# FABRICA_WP=123
# FABRICA_ORG=tailoy
# FABRICA_REPO=mi-requerimiento
# FABRICA_BRANCH=main
