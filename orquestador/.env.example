# Variables del orquestador. Copiar a .env y rellenar. .env NO se versiona.
#
#   Copy-Item .env.example .env
#
# Las URLs usan los nombres de servicio del stack de ../local (worker y
# webhook se unen a esa red). Para AWS se cambian por las URLs publicas.

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
FACTORY_TASK_QUEUE=fabrica
TEMPORAL_DB_PASSWORD=CHANGE_ME

# --- OpenProject (API v3) ---
OPENPROJECT_BASE_URL=http://web:8080
OPENPROJECT_HOST_HEADER=localhost:8080
OPENPROJECT_API_TOKEN=CHANGE_ME

# --- Gitea (API v1) ---
GITEA_BASE_URL=http://gitea:3000
GITEA_API_TOKEN=CHANGE_ME
FACTORY_GITEA_OWNER=CHANGE_ME
FACTORY_GITEA_REPO=CHANGE_ME

# --- Webhook de OpenProject ---
# Vacio = validacion de firma desactivada (solo aceptable en desarrollo).
OPENPROJECT_WEBHOOK_SECRET=

# --- Agente de IA ---
# Vacio = el agente usa un marcador determinista; el pipeline corre igual.
ANTHROPIC_API_KEY=
FACTORY_MODEL=claude-sonnet-4-6

# --- Estados del workflow de OpenProject (decision #9 del brief) ---
# Nombres logicos por defecto. Ajustar a los estados REALES de la instancia.
OP_STATUS_ASSIGNED=Asignado a la fabrica
OP_STATUS_IN_REVIEW=En revision
OP_STATUS_IN_DEVELOPMENT=En desarrollo
OP_STATUS_CLIENT_OK=VoBo del cliente
OP_STATUS_AWAITING_CLARIFICATION=Esperando clarificacion

# --- Arquitectura del proyecto (cacheada en el system del agente) ---
# Archivo Markdown en un repo de Gitea. Vacio = el agente corre sin contexto
# arquitectonico (los NFR salen genericos).
FACTORY_ARCH_REPO=mcp-agent/fabrica-arquitectura
FACTORY_ARCH_PATH=arquitectura.md
FACTORY_ARCH_BRANCH=main
